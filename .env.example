# ==============================================================================
# BreatheWise - Environment Variables Example
# ==============================================================================
# NEVER commit .env to version control.
# Copy this file to .env and configure real credentials.

# --- Backend Configuration ---
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="BreatheWise Backend"

# Data Providers (Optional - graceful degradation to verified open grids if unset)
# CPCB via Open Government Data India (data.gov.in)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# OpenAQ v3 API Key (explore.openaq.org)
OPENAQ_API_KEY=your_openaq_v3_api_key_here

# LLM Providers (Server-side only)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Service Thresholds
HTTP_TIMEOUT_SECONDS=10.0
CACHE_TTL_SECONDS=900
STALE_DATA_THRESHOLD_HOURS=6

# CPCB / data.gov.in adapter
CPCB_PAGE_SIZE=100
CPCB_MAX_PAGES=10
CPCB_MAX_RETRIES=2
CPCB_BACKOFF_BASE_SECONDS=0.5
CPCB_CONNECT_TIMEOUT_SECONDS=5.0
CPCB_READ_TIMEOUT_SECONDS=20.0
# Per-request ceiling so an unreachable provider cannot block failover to
# OpenAQ/Open-Meteo or exceed the frontend proxy timeout.
CPCB_REQUEST_BUDGET_SECONDS=3.0
CPCB_CIRCUIT_BREAKER_SECONDS=60.0
CPCB_CACHE_TTL_SECONDS=300
CPCB_LAST_VALID_MAX_HOURS=24
CPCB_FRESH_HOURS=2
CPCB_DELAYED_HOURS=6
# Keep false until the deployed feed's averaging period is verified.
CPCB_AVERAGING_PERIOD_VERIFIED=false

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend Configuration ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

