# ==============================================================================
# BreatheWise - Environment Variables Example
# ==============================================================================
# NEVER commit .env to version control.
# Copy this file to .env and configure real credentials.

# --- Backend Configuration ---
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="BreatheWise Backend"

# Data Providers (Optional - graceful degradation to verified open grids if unset)
# CPCB via Open Government Data India (data.gov.in)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# OpenAQ v3 API Key (explore.openaq.org)
OPENAQ_API_KEY=your_openaq_v3_api_key_here

# LLM Providers (Server-side only)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Free-tier model failover chain, tried in order. Rate limits/503/malformed JSON
# on one model automatically move to the next. Keys are never logged.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
LLM_REQUEST_BUDGET_SECONDS=20.0
GEMINI_MODEL_TIMEOUT_SECONDS=10.0
GEMMA_MODEL_TIMEOUT_SECONDS=12.0

# Rate limits (per client IP; expensive routes use their own smaller bucket)
RATE_LIMIT_STORE=memory
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ASSISTANT_REQUESTS=10
RATE_LIMIT_LOCATION_REQUESTS=20
# Shared store is opt-in; inject credentials through the deployment secret store.
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=0.1
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
# Only these peers may supply X-Forwarded-For/X-Real-IP to the rate limiter.
TRUSTED_PROXY_IPS=[]
# Bound attacker-controlled cache keys.
CACHE_MAX_ENTRIES=1000
CPCB_MAX_LOCKS=500
API_MAX_PAGE_SIZE=500

# Service Thresholds
HTTP_TIMEOUT_SECONDS=10.0
CACHE_TTL_SECONDS=900
STALE_DATA_THRESHOLD_HOURS=6

# CPCB / data.gov.in adapter
CPCB_PAGE_SIZE=100
CPCB_MAX_PAGES=10
CPCB_MAX_RETRIES=2
CPCB_BACKOFF_BASE_SECONDS=0.5
CPCB_CONNECT_TIMEOUT_SECONDS=5.0
CPCB_READ_TIMEOUT_SECONDS=20.0
# Per-request ceiling so an unreachable provider cannot block failover to
# OpenAQ/Open-Meteo or exceed the frontend proxy timeout.
CPCB_REQUEST_BUDGET_SECONDS=3.0
CPCB_CIRCUIT_BREAKER_SECONDS=60.0
CPCB_CACHE_TTL_SECONDS=300
CPCB_LAST_VALID_MAX_HOURS=24
CPCB_FRESH_HOURS=2
CPCB_DELAYED_HOURS=6
# Keep false until the deployed feed's averaging period is verified.
CPCB_AVERAGING_PERIOD_VERIFIED=false

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend Configuration ---
# Local `next dev` only: set this in frontend/.env.local or export it in the
# shell; the public /api/v1 and /health route handlers read it at request time.
# On Vercel, do NOT set this yourself: the frontend service's `backend` binding
# injects the deployment-aware value into functions.
BACKEND_URL=http://127.0.0.1:8000
# Keep empty: browser requests stay on the deployment origin, where Next.js
# route handlers proxy the explicit API allowlist to the backend binding.
# A remote value is ignored in production.
NEXT_PUBLIC_API_BASE_URL=

