{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/v1/air-quality",
      "destination": "https://breathewise-backend.onrender.com/api/v1/air-quality"
    },
    {
      "source": "/api/v1/assistant/chat",
      "destination": "https://breathewise-backend.onrender.com/api/v1/assistant/chat"
    },
    {
      "source": "/api/v1/locations/reverse",
      "destination": "https://breathewise-backend.onrender.com/api/v1/locations/reverse"
    },
    {
      "source": "/api/v1/locations/search",
      "destination": "https://breathewise-backend.onrender.com/api/v1/locations/search"
    },
    {
      "source": "/api/v1/recommendations/indoor",
      "destination": "https://breathewise-backend.onrender.com/api/v1/recommendations/indoor"
    },
    {
      "source": "/api/v1/recommendations/plan",
      "destination": "https://breathewise-backend.onrender.com/api/v1/recommendations/plan"
    },
    {
      "source": "/api/v1/recommendations/sustainable-alternatives",
      "destination": "https://breathewise-backend.onrender.com/api/v1/recommendations/sustainable-alternatives"
    },
    {
      "source": "/api/v1/stations",
      "destination": "https://breathewise-backend.onrender.com/api/v1/stations"
    },
    {
      "source": "/api/v1/stations/comparison-presets",
      "destination": "https://breathewise-backend.onrender.com/api/v1/stations/comparison-presets"
    },
    {
      "source": "/api/v1/stations/compare",
      "destination": "https://breathewise-backend.onrender.com/api/v1/stations/compare"
    },
    {
      "source": "/health",
      "destination": "https://breathewise-backend.onrender.com/health"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_ENV": "production"
  }
}
